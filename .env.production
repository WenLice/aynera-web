# Read by `next build`, which bakes NEXT_PUBLIC_* values into the client bundle.
#
# Committed on purpose: anything prefixed NEXT_PUBLIC_ ends up in JavaScript the browser
# downloads, so it is public by definition and holds no secret. Keeping it here means a
# release built by anyone — or by a CI runner — points at the same API instead of silently
# falling back to the http://localhost:5057 default and shipping a site whose forms cannot work.
#
# Temporary host while the production domain is set up. The API must also list this site's
# origin under Aynera:Cors:Origins, or the browser will block every request.
NEXT_PUBLIC_AYNERA_API_BASE_URL=https://aynera-api.onrender.com
